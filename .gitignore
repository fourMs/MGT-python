__pycache__/

# Generated media and analysis output. These patterns are deliberately broad, because
# running the toolbox scatters them through the tree --- but broad patterns swallow real
# files silently, and a test fixture that git never tracked passes locally and fails in CI
# with a missing file. So anything under tests/ is exempt below, and so is any directory
# named fixtures/ or data/.
*.mp4
*.csv
*.eps
*.tiff
*.bmp
*.DS_Store
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.txt
*.tff
*.tsv

# Files that must be tracked despite matching the patterns above. Add to this list rather
# than narrowing a pattern: the patterns earn their keep on generated output.
!docs/requirements.txt
!tests/**
!**/fixtures/**
!**/testdata/**

# ...but those exemptions are broad in their turn, and a negation later in the file beats
# an earlier rule. Without these, `!tests/**` would un-ignore tests/__pycache__ and every
# other piece of tooling debris under tests/.
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints
*/.ipynb_checkpoints/*
fix_notebook.py
read_readme.py
dist
build
install_test_venv
musicalgestures.egg-info
test-videos
.vscode/settings.json
dance.avi
musicalgestures/pose/mpi/pose_iter_160000.caffemodel
musicalgestures/pose/coco/pose_iter_440000.caffemodel
MusicalGesturesToolbox_devlocal.ipynb
musicalgestures/interactive.py
musicalgestures/pytest.ini
pytest.ini
tests/.coverage
tests/.vs/slnx.sqlite
tests/pytest.ini
tests/htmlcov
musicalgestures/pose/body_25/pose_iter_584000.caffemodel
musicalgestures/pose/body_25/.wget-hsts
dancer_grid.png
musicalgestures/models/pose_landmarker_*.task

# Generated example outputs (keep only the source example media/scripts)
musicalgestures/examples/*
!musicalgestures/examples/dancer.avi
!musicalgestures/examples/pianist.avi
!musicalgestures/examples/Filtering.ipynb
!musicalgestures/examples/test_dance.py
!musicalgestures/examples/test_pianist.py

# Local scratch folder (blog drafts etc.) — not tracked
temp/

# mkdocs build output (site_dir in mkdocs.yml); published by CI, not committed
site/
